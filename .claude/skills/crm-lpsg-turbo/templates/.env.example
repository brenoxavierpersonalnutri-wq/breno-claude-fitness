# =============================================================================
# crm-lpsg-turbo · .env.example
# Copie para .env.local e preencha. NUNCA versione o .env.local.
# =============================================================================

# --- Supabase --------------------------------------------------------------
# Vão para o browser. Podem ser públicas.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY. Ignora RLS por definição — só os webhooks usam.
# Se esta chave vazar para o browser, todo o banco fica exposto.
SUPABASE_SERVICE_ROLE_KEY=

# --- Webhooks --------------------------------------------------------------
# Token da Hotmart (HOTTOK). Toda requisição sem ele é rejeitada.
HOTMART_HOTTOK=

# Segredo próprio da ficha de interesse. Gere com: openssl rand -hex 32
# A página precisa enviar no header X-Ficha-Secret.
FICHA_WEBHOOK_SECRET=

# --- Aplicação -------------------------------------------------------------
# URL pública, usada nos links e no redirect de autenticação.
NEXT_PUBLIC_APP_URL=https://crm.seudominio.com.br

# Código da edição corrente (LPSG-W12). O import e os webhooks usam como padrão
# quando a origem não informa a edição.
EDICAO_CORRENTE=LPSG-W99
